      <name>fancy_table_3</name>
      <pose>1.12 0.56 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_4</name>
      <pose>0 0.56 0 0 0 0</pose>
    </include>

    <!-- ================= INDUSTRIAL FLOOR ================= -->
    <model name='ground_plane'>
      <static>true</static>

      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>

        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.16 0.18 0.20 1</ambient>
            <diffuse>0.22 0.25 0.28 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <pose>0 0 0 0 0 0</pose>

        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>

        <enable_wind>false</enable_wind>
      </link>

      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ================= FACTORY REAR WALL ================= -->
    <model name='industrial_back_wall'>
      <static>true</static>
      <pose>0.56 -3.20 1.50 0 0 0</pose>

      <link name='wall_link'>
