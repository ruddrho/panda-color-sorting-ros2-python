<sdf version='1.9'>
  <world name='pick_and_place_world'>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Industrial environment lighting -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.12 0.15 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= RED BOX ================= -->
    <model name='red_box'>
      <pose>0.25 0.6 0.39 0 0 0</pose>
      <static>false</static>

      <link name='red_link'>
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>0.000089</ixx>
            <iyy>0.000089</iyy>
            <izz>0.000070</izz>
          </inertia>
        </inertial>

        <collision name='red_collision'>
          <geometry>
            <box>
              <size>0.065 0.065 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name='red_visual'>
          <geometry>
            <box>
              <size>0.065 0.065 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.05 0.05 1</ambient>
            <diffuse>1 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= GREEN BOX ================= -->
    <model name='green_box'>
      <pose>0.55 0.6 0.38 0 0 1.5708</pose>
      <static>false</static>

      <link name='green_link'>
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.00007</ixx>
            <iyy>0.00012</iyy>
            <izz>0.00013</izz>
          </inertia>
        </inertial>

        <collision name='green_collision'>
          <geometry>
            <box>
              <size>0.10 0.06 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name='green_visual'>
          <geometry>
            <box>
              <size>0.10 0.06 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 1 0.10 1</ambient>
            <diffuse>0.05 1 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= BLUE BOX ================= -->
    <model name='blue_box'>
      <pose>0.85 0.6 0.40 0 0 0</pose>
      <static>false</static>

      <link name='blue_link'>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.00011</ixx>
            <iyy>0.00009</iyy>
            <izz>0.00007</izz>
          </inertia>
        </inertial>

        <collision name='blue_collision'>
          <geometry>
            <box>
              <size>0.06 0.08 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name='blue_visual'>
          <geometry>
            <box>
              <size>0.06 0.08 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.15 1 1</ambient>
            <diffuse>0.05 0.15 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= CONTAINERS ================= -->
    <include>
      <uri>model://sorting_container</uri>
      <name>red_container</name>
      <pose>0.25 -0.56 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://sorting_container_green</uri>
      <name>green_container</name>
      <pose>0.55 -0.56 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://sorting_container_blue</uri>
      <name>blue_container</name>
      <pose>0.85 -0.56 0 0 0 0</pose>
    </include>

    <!-- ================= TABLES ================= -->
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_5</name>
      <pose>0 -0.56 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_6</name>
      <pose>1.12 -0.56 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_2</name>
      <pose>1.12 0 0 0 0 0</pose>
    </include>

    <include>
