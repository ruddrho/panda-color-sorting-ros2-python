            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>

        <!-- Orange tool cabinet -->
        <visual name='tool_cabinet'>
          <pose>0.30 0 0.54 0 0 0</pose>
          <geometry>
            <box><size>0.62 0.52 0.42</size></box>
          </geometry>
          <material>
            <ambient>0.48 0.15 0.02 1</ambient>
            <diffuse>0.88 0.30 0.04 1</diffuse>
            <specular>0.20 0.16 0.08 1</specular>
          </material>
        </visual>

        <visual name='lower_support'>
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <box><size>1.18 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Static wall-mounted industrial fan -->
    <model name='industrial_wall_fan'>
      <static>true</static>
      <pose>0.56 -3.10 2.15 0 0 0</pose>

      <link name='fan_link'>

        <!-- Rear circular housing -->
        <visual name='fan_housing'>
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.62</radius>
              <length>0.045</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.04 0.045 1</ambient>
            <diffuse>0.08 0.09 0.10 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>

        <!-- Fan blades -->
        <visual name='blade_horizontal'>
          <pose>0 0.04 0 0 0 0</pose>
          <geometry>
            <box><size>1.00 0.05 0.13</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.20 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
            <specular>0.30 0.30 0.30 1</specular>
          </material>
        </visual>

        <visual name='blade_vertical'>
          <pose>0 0.04 0 0 0 0</pose>
          <geometry>
            <box><size>0.13 0.05 1.00</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.20 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
            <specular>0.30 0.30 0.30 1</specular>
          </material>
        </visual>

        <visual name='blade_diagonal_1'>
          <pose>0 0.05 0 0 0.7854 0</pose>
          <geometry>
            <box><size>1.00 0.05 0.13</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.20 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
            <specular>0.30 0.30 0.30 1</specular>
          </material>
        </visual>

        <visual name='blade_diagonal_2'>
          <pose>0 0.05 0 0 -0.7854 0</pose>
          <geometry>
            <box><size>1.00 0.05 0.13</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.20 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
            <specular>0.30 0.30 0.30 1</specular>
          </material>
        </visual>

        <!-- Yellow fan hub -->
        <visual name='fan_hub'>
          <pose>0 0.09 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.36 0.01 1</ambient>
            <diffuse>0.95 0.65 0.03 1</diffuse>
            <specular>0.30 0.25 0.10 1</specular>
          </material>
        </visual>

      </link>
    </model>
    <!-- ================= MAIN LIGHT ================= -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>

      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

  </world>
</sdf>